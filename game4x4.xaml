<Window x:Class="PuzzelGame.game4x4"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="800" Width="800">
    <Grid ShowGridLines="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="600" />
            <ColumnDefinition Width="100" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="600" />
            <RowDefinition Height="100" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Grid.Column="1">
            <Label x:Name="Timer" Content="00:00" FontSize="72" HorizontalAlignment="Center"></Label>
        </Grid>
        <Grid x:Name="PuzzleGrid" ShowGridLines="True" Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="150"/>
                <RowDefinition Height="150"/>
                <RowDefinition Height="150"/>
                <RowDefinition Height="150"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <Image x:Name="Image1" Source="pack://application:,,,/Assets/1_number.bmp" Grid.Row="0" Grid.Column="0" AllowDrop="False" Drop="Image_Drop" MouseMove="Image_MouseMove"/>
            <Image x:Name="Image2" Source="pack://application:,,,/Assets/2_number.bmp" Grid.Row="0" Grid.Column="1" AllowDrop="False" Drop="Image_Drop" MouseMove="Image_MouseMove"/>
            <Image x:Name="Image3" Source="pack://application:,,,/Assets/3_number.bmp" Grid.Row="0" Grid.Column="2" AllowDrop="False" Drop="Image_Drop" MouseMove="Image_MouseMove"/>
            <Image x:Name="Image4" Source="pack://application:,,,/Assets/4_number.bmp" Grid.Row="0" Grid.Column="3" AllowDrop="False" Drop="Image_Drop" MouseMove="Image_MouseMove"/>
            <Image x:Name="Image5" Source="pack://application:,,,/Assets/5_number.bmp" Grid.Row="1" Grid.Column="0" AllowDrop="False" Drop="Image_Drop" MouseMove="Image_MouseMove"/>
            <Image x:Name="Image6" Source="pack://application:,,,/Assets/6_number.bmp" Grid.Row="1" Grid.Column="1" AllowDrop="False" Drop="Image_Drop" MouseMove="Image_MouseMove"/>
            <Image x:Name="Image7" Source="pack://application:,,,/Assets/7_number.bmp" Grid.Row="1" Grid.Column="2" AllowDrop="False" Drop="Image_Drop" MouseMove="Image_MouseMove" />
            <Image x:Name="Image8" Source="pack://application:,,,/Assets/8_number.bmp" Grid.Row="1" Grid.Column="3" AllowDrop="False" Drop="Image_Drop" MouseMove="Image_MouseMove" />
            <Image x:Name="Image9" Source="pack://application:,,,/Assets/9_number.bmp" Grid.Row="2" Grid.Column="0" AllowDrop="False" Drop="Image_Drop" MouseMove="Image_MouseMove"/>
            <Image x:Name="Image10" Source="pack://application:,,,/Assets/10_number.bmp" Grid.Row="2" Grid.Column="1" AllowDrop="False" Drop="Image_Drop" MouseMove="Image_MouseMove"/>
            <Image x:Name="Image11" Source="pack://application:,,,/Assets/11_number.bmp" Grid.Row="2" Grid.Column="2" AllowDrop="False" Drop="Image_Drop" MouseMove="Image_MouseMove"/>
            <Image x:Name="Image12" Source="pack://application:,,,/Assets/12_number.bmp" Grid.Row="2" Grid.Column="3" AllowDrop="False" Drop="Image_Drop" MouseMove="Image_MouseMove"/>
            <Image x:Name="Image13" Source="pack://application:,,,/Assets/13_number.bmp" Grid.Row="3" Grid.Column="0" AllowDrop="False" Drop="Image_Drop" MouseMove="Image_MouseMove"/>
            <Image x:Name="Image14" Source="pack://application:,,,/Assets/14_number.bmp" Grid.Row="3" Grid.Column="1" AllowDrop="False" Drop="Image_Drop" MouseMove="Image_MouseMove"/>
            <Image x:Name="Image15" Source="pack://application:,,,/Assets/15_number.bmp" Grid.Row="3" Grid.Column="2" AllowDrop="False" Drop="Image_Drop" MouseMove="Image_MouseMove"/>
            <Image x:Name="Image0" Source="pack://application:,,,/Assets/0_number.bmp" Grid.Row="3" Grid.Column="3" AllowDrop="True" Drop="Image_Drop" MouseMove="Image_MouseMove"/>
        </Grid>
        <StackPanel Orientation="Horizontal"
                    Grid.Row="2" Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,0,0,35">

            <Button x:Name="homeknop" Content="🏠" Width="50" Height="50" Margin="10"/>
            <Button x:Name="scoreknop" Content="📊" Width="50" Height="50" Margin="10"/>
            <Button x:Name="uitlegknop" Content="?" Width="50" Height="50" Margin="10"/>
        </StackPanel>
    </Grid>
</Window>
