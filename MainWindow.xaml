<Window x:Class="PuzzelGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StartScherm"
        Height="450" Width="800"
        Background="#FDCFA8">
    <Grid>
        <Canvas>
            <!-- Big rect -->
            <Rectangle
                Width="404" Height="177"
                Canvas.Left="198" Canvas.Top="164"
                Fill="#B18864" 
                MouseLeftButtonDown="Play_Click"/>

            <!-- Smoll rect inside big one -->
            <Rectangle
                Width="363" Height="152"
                Canvas.Left="218.5" Canvas.Top="176.5"
                Fill="#996E48" 
                MouseLeftButtonDown="Play_Click"/>

            <!-- play button triangle -->
            <Polygon
                Points="400,185 365,237.5 435,237.5"
                Fill="White" RenderTransformOrigin="0.5,0.5" Canvas.Top="-46" Canvas.Left="274"
                MouseLeftButtonDown="Play_Click">
                <Polygon.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="90"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Polygon.RenderTransform>
            </Polygon>

            <TextBlock 
                Canvas.Left="314" 
                Canvas.Top="115"
                Text="Sliding Puzzle"
                FontSize="24"
                FontWeight="Bold"
                Foreground="#000000" HorizontalAlignment="Left" VerticalAlignment="Top">
            </TextBlock>

            <!--onderbalk met iconknoppen-->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"  
                        Canvas.Left="692" 
                        Canvas.Top="371">


                <Button x:Name="scoreknop" Content="📊" Width="30" Height="30" Margin="5" />
                <Button x:Name="uitlegknop" Content="?" Width="30" Height="30" Margin="5" MouseLeftButtonDown="uitlegknopmethode"/>
            </StackPanel>


        </Canvas>
    </Grid>
</Window>
