<Window x:Class="Gameinteraction_groep1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Gameinteraction_groep1"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="800">
    <Grid ShowGridLines="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="600" />
            <ColumnDefinition Width="100" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="600" />
            <RowDefinition Height="100" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Grid.Column="1">
            <Label FontSize="72" HorizontalAlignment="Center">00:00</Label>
        </Grid>
        <Grid ShowGridLines="True" Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="200"/>
                <RowDefinition Height="200"/>
                <RowDefinition Height="200"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <Image x:Name="Image1" Source="pack://application:,,,/Assets/1_number.bmp" Grid.Row="0" Grid.Column="0" AllowDrop="True" Drop="Image_Drop" MouseMove="Image_MouseMove"/>
            <Image x:Name="Image2" Source="pack://application:,,,/Assets/2_number.bmp" Grid.Row="0" Grid.Column="1" AllowDrop="True" Drop="Image_Drop" MouseMove="Image_MouseMove"/>
            <Image x:Name="Image3" Source="pack://application:,,,/Assets/3_number.bmp" Grid.Row="0" Grid.Column="2" AllowDrop="True" Drop="Image_Drop" MouseMove="Image_MouseMove"/>
            <Image x:Name="Image4" Source="pack://application:,,,/Assets/4_number.bmp" Grid.Row="1" Grid.Column="0" AllowDrop="True" Drop="Image_Drop" MouseMove="Image_MouseMove"/>
            <Image x:Name="Image5" Source="pack://application:,,,/Assets/5_number.bmp" Grid.Row="1" Grid.Column="1" AllowDrop="True" Drop="Image_Drop" MouseMove="Image_MouseMove"/>
            <Image x:Name="Image6" Source="pack://application:,,,/Assets/6_number.bmp" Grid.Row="1" Grid.Column="2" AllowDrop="True" Drop="Image_Drop" MouseMove="Image_MouseMove"/>
            <Image x:Name="Image7" Source="pack://application:,,,/Assets/7_number.bmp" Grid.Row="2" Grid.Column="0" AllowDrop="True" Drop="Image_Drop" MouseMove="Image_MouseMove" />
            <Image x:Name="Image8" Source="pack://application:,,,/Assets/8_number.bmp" Grid.Row="2" Grid.Column="1" AllowDrop="True" Drop="Image_Drop" MouseMove="Image_MouseMove" />
            <Image x:Name="Image9" Source="pack://application:,,,/Assets/0_number.bmp" Grid.Row="2" Grid.Column="2" AllowDrop="True" Drop="Image_Drop" MouseMove="Image_MouseMove"/>
        </Grid>
    </Grid>
</Window>
