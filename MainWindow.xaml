<Window x:Class="PuzzelGame.Main"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PuzzelGame"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button HorizontalAlignment="Center" VerticalAlignment="Center" Width="200" Height="100" FontSize="48" Click="Start_Click">Start</Button>
        <Button HorizontalAlignment="Left" VerticalAlignment="Center" Width="200" Height="100" FontSize="36" Click="Scoreboard_Click">ScoreBoard</Button>
    </Grid>
</Window>
