<Window x:Class="PuzzelGame.DifficultyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kies moeilijkheid" Height="450" Width="800" Background="#F4C99B">

    <Grid>
        <!-- dit is titel -->
        <Label Content="Difficulty"
               HorizontalAlignment="Center"
               VerticalAlignment="Top"
               FontSize="50"
               FontWeight="Bold"
               Margin="0,60,0,0"/>

        <!--moeijlijkheids knopen-->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,150">

            <Button x:Name="knop3x3" Content="3 x 3"
                    Width="120" Height="60"
                    FontSize="30"
                    Background="#A47148"
                    Foreground="White"
                    Margin= "30"/>

            <Button x:Name="knop4x4" Content="4 x 4"
                    Width="120" Height="60"
                    FontSize="30"
                    Background="#A47148"
                    Foreground="White"
                    Margin="30"/>


        </StackPanel>

        <!--onderbalk met iconknoppen-->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,15,15">

            <Button x:Name="homeknop" Content="🏠" Width="30" Height="30" Margin="5"  />
            <Button x:Name="scoreknop" Content="📊" Width="30" Height="30" Margin="5" />
            <Button x:Name="uitlegknop" Content="?" Width="30" Height="30" Margin="5" />
        </StackPanel>
    </Grid>
</Window>