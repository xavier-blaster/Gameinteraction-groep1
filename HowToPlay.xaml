<Window x:Class="PuzzelGame.HowToPlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HowToPlay"
        Height="450" Width="800"
        Background="#FDCFA8">
    <Grid>
        <Canvas>
            <!-- Background for text -->
            <Rectangle Width="364" Height="279"
                       Canvas.Left="196" Canvas.Top="93"
                       Fill="#996E48" HorizontalAlignment="Left" VerticalAlignment="Center" />

            <!-- Container for Title and Body -->
            <Grid Canvas.Left="196" Canvas.Top="93" Width="364" Height="279" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title TextBlock -->
                <TextBlock Text="Hoe moet je spelen"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#000000"
                           HorizontalAlignment="Center"
                           Margin="0,-60,0,80"/>

                <!-- How To Play Body TextBlock -->
                <TextBlock
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="#FAF9F6"
                           TextWrapping="Wrap"
                           Margin="10,10,10,10" Grid.RowSpan="2"><Run Text="Doel: Zet de cijfers in de juiste volgorde van 1 t/m 9, met het lege vakje rechtsonder."/><LineBreak/><Run Text=" "/><LineBreak/><Run Text="Schuiven: Je kunt een blokje verplaatsen naar het lege vakje door erop te klikken of te schuiven (alleen als het ernaast ligt)."/><LineBreak/><Run Text="  "/><LineBreak/><Run Text="Blijf schuiven tot alle cijfers netjes op volgorde staan"/></TextBlock>
            </Grid>

            <!--onderbalk met iconknoppen-->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center" 
                        Canvas.Left="693" 
                        Canvas.Top="370">

                <Button x:Name="homeknop" Content="??" Width="30" Height="30" Margin="5"  />
                <Button x:Name="scoreknop" Content="??" Width="30" Height="30" Margin="5" />

            </StackPanel>
        </Canvas>
    </Grid>
</Window>
